[Unit]
Description=Logoped Yordamchisi — Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/logoped-bot
ExecStart=/usr/bin/python3 /home/ubuntu/logoped-bot/logoped_bot.py
Restart=always
RestartSec=10
Environment=PORT=0
EnvironmentFile=/home/ubuntu/logoped-bot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

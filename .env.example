# ==========================================================
#  TELEGRAM BOT SOZLAMALARI  (bu faylni ".env" deb nusxalang)
# ==========================================================

# @BotFather dan olgan token
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adminlar Telegram ID si (bir nechta bo'lsa vergul bilan ajrating)
# O'zingizni topish: @userinfobot
ADMIN_IDS=111111111

# /admin buyrug'i uchun parol
ADMIN_PASSWORD=kiriting-bu-yerga-kuchli-parol


# ==========================================================
#  Ixtiyoriy sozlamalar (o'sh qatorlarni o'zgartirmasangiz
#  ham bo'ladi) — quyidagilar serverga joylash uchun
# ==========================================================

# Bazа fayli joylashuvi. Docker/Oracle da doimiy diskka qo'yamiz:
# DB_PATH=/data/logoped.db

# Health-check porti (Render / Fly / HF Spaces uchun). 0 = o'chirilgan.
# PORT=8080

# Bot qayta ishga tushganda navbatdagi xabarlarni o'chirish.
# TRUE qiling (default) faqat BIRINCHI marta o'rnatishda.
# Keyin FALSE qoldiring — aks holda bot to'xtagan paytdagi
# xabarlar butunlay yo'qoladi!
# DROP_PENDING_UPDATES=true
